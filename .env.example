# Copy to .env and fill in. .env is gitignored: it never leaves the server.
#   cp .env.example .env
#   openssl rand -base64 32     # run once per secret below

POSTGRES_USER=roomplanner
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=roomplanner

# Typed once into the desktop app on first run to create the workspace.
BOOTSTRAP_SECRET=CHANGE_ME

API_DOMAIN=api.example.fr
ACME_EMAIL=you@example.fr
